// System-wide fastfetch config for Alnix. Users can override it with
// ~/.config/fastfetch/config.jsonc.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/alnix/fastfetch-logo.txt",
        "color": {
            "1": "38;2;79;195;247",
            "2": "38;2;72;189;242",
            "3": "38;2;65;183;238",
            "4": "38;2;58;177;233",
            "5": "38;2;51;171;228",
            "6": "38;2;44;165;223",
            "7": "38;2;37;159;218",
            "8": "38;2;30;153;214",
            "9": "38;2;23;147;209"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "color": {
            "keys": "38;2;23;147;209",
            "title": "38;2;79;195;247"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "break",
        "colors"
    ]
}
